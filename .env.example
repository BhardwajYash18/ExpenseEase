# ExpensEase - Root Environment Configuration Template
# Duplicate this file to .env for local Docker Compose or local orchestration.

# PostgreSQL Configuration (Docker / Local)
POSTGRES_USER=expensease_user
POSTGRES_PASSWORD=expensease_secure_password
POSTGRES_DB=expensease_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Backend Configuration
BACKEND_PORT=5000
NODE_ENV=development
JWT_SECRET=<your-strong-random-secret-here>
JWT_EXPIRES_IN=24h

# AI Service Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=ai-service

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:5000
