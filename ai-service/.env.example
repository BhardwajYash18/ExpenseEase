# ExpenseEase AI Service — Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development   # development | test | production
LOG_LEVEL=info            # debug | info | warning | error

# ─── Security ─────────────────────────────────────────────────────────────────
# Must match JWT_SECRET in the Node.js backend exactly.
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_SHARED_SECRET
JWT_ALGORITHM=HS256

# ─── AI / LLM Provider ────────────────────────────────────────────────────────
# Set AI_PROVIDER=llm to enable real LLM calls; use "mock" for CI / offline.
AI_PROVIDER=mock
AI_API_KEY=REPLACE_WITH_YOUR_API_KEY
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=1

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
