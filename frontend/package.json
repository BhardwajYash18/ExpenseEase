{
  "name": "expensease-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ExpensEase Responsive Progressive Web Application (PWA)",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"frontend,backend,ai\" -c \"cyan.bold,blue.bold,magenta.bold\" \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix ../backend run dev",
    "dev:ai": "node scripts/start-ai.cjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "vite": "^5.4.14"
  }
}
